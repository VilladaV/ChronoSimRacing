{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the ChronoSim application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user. (Primary Key)"
        },
        "email": {
          "type": "string",
          "description": "Email address of the user.",
          "format": "email"
        },
        "nombre": {
          "type": "string",
          "description": "Name of the user."
        },
        "rol": {
          "type": "string",
          "description": "Role of the user (e.g., 'admin')."
        }
      },
      "required": [
        "id",
        "email",
        "nombre",
        "rol"
      ]
    },
    "Game": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Game",
      "type": "object",
      "description": "Represents a racing game in the ChronoSim application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the game. (Primary Key)"
        },
        "nombre": {
          "type": "string",
          "description": "Name of the game (e.g., 'Assetto Corsa')."
        },
        "desarrollador": {
          "type": "string",
          "description": "Developer of the game (e.g., 'Kunos Simulazioni')."
        },
        "imageUrl": {
          "type": "string",
          "format": "uri",
          "description": "URL for the game's background image."
        }
      },
      "required": [
        "id",
        "nombre",
        "desarrollador"
      ]
    },
    "Track": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Track",
      "type": "object",
      "description": "Represents a racing track in the ChronoSim application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the track. (Primary Key)"
        },
        "nombre": {
          "type": "string",
          "description": "Name of the track (e.g., 'Targa Florio')."
        },
        "pais": {
          "type": "string",
          "description": "Country where the track is located (e.g., 'Italia')."
        },
        "longitudKm": {
          "type": "number",
          "description": "Length of the track in kilometers (e.g., 72)."
        },
        "juegoId": {
          "type": "string",
          "description": "Reference to the Game entity. (Relationship: Game 1:N Track)"
        }
      },
      "required": [
        "id",
        "nombre",
        "pais",
        "longitudKm",
        "juegoId"
      ]
    },
    "Car": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Car",
      "type": "object",
      "description": "Represents a racing car in the ChronoSim application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the car. (Primary Key)"
        },
        "nombre": {
          "type": "string",
          "description": "Name of the car (e.g., 'Ferrari 488 GT3')."
        },
        "notasRendimiento": {
          "type": "string",
          "description": "Performance notes about the car (e.g., 'Good in fast corners')."
        },
        "imageUrl": {
          "type": "string",
          "format": "uri",
          "description": "URL for the car's image."
        },
        "potenciaCV": {
            "type": "number",
            "description": "Power of the car in horsepower (CV)."
        },
        "pesoKG": {
            "type": "number",
            "description": "Weight of the car in kilograms (KG)."
        }
      },
      "required": [
        "id",
        "nombre"
      ]
    },
    "Pilot": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Pilot",
      "type": "object",
      "description": "Represents a racing pilot in the ChronoSim application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the pilot. (Primary Key)"
        },
        "nombre": {
          "type": "string",
          "description": "Name of the pilot (e.g., 'Javier \\'El Fantasma\\' Rojas')."
        },
        "nacionalidad": {
          "type": "string",
          "description": "Nationality of the pilot (e.g., 'Colombia')."
        },
        "biografia": {
          "type": "string",
          "description": "Biography of the pilot (may be generated by AI)."
        },
        "esJugador": {
          "type": "boolean",
          "description": "Indicates whether the pilot is the real user (true) or a simulated profile (false)."
        },
        "avatarUrl": {
            "type": "string",
            "format": "uri"
        },
        "teamId": {
            "type": "string"
        }
      },
      "required": [
        "id",
        "nombre",
        "nacionalidad",
        "biografia",
        "esJugador"
      ]
    },
    "Team": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Team",
      "type": "object",
      "description": "Represents a racing team in the ChronoSim application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the team. (Primary Key)"
        },
        "nombre": {
          "type": "string",
          "description": "Name of the team."
        },
        "logoUrl": {
          "type": "string",
          "format": "uri",
          "description": "URL of the team's logo."
        },
        "lema": {
          "type": "string",
          "description": "Motto or slogan of the team."
        },
        "descripcion": {
            "type": "string",
            "description": "A detailed description of the team."
        },
        "colorPrimario": {
            "type": "string",
            "description": "Primary color of the team in HEX format (e.g. #FF0000)."
        },
        "colorSecundario": {
            "type": "string",
            "description": "Secondary color of the team in HEX format (e.g. #0000FF)."
        }
      },
      "required": [
        "id",
        "nombre"
      ]
    },
    "Event": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Event",
      "type": "object",
      "description": "Represents a racing event in the ChronoSim application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the event. (Primary Key)"
        },
        "nombre": {
          "type": "string",
          "description": "Name of the event (e.g., 'Campeonato Mundial de Rally BeamNG 2025')."
        },
        "juegoId": {
          "type": "string",
          "description": "Reference to the Game entity. (Relationship: Game 1:N Event)"
        },
        "tipo": {
          "type": "string",
          "description": "Type of the event (e.g., 'Campeonato', 'Torneo', 'Contrarreloj')."
        },
        "estado": {
          "type": "string",
          "description": "Status of the event (e.g., 'Planificado', 'En curso', 'Finalizado')."
        },
        "fechaInicio": {
          "type": "string",
          "description": "Start date of the event.",
          "format": "date-time"
        },
        "pistas": {
          "type": "array",
          "description": "References to Track entities. (Relationship: Event N:N Track)",
          "items": {
            "type": "string"
          }
        },
        "participantes": {
          "type": "array",
          "description": "Array of objects representing participants (pilot/car combinations).",
          "items": {
            "type": "object",
            "properties": {
              "pilotoId": { "type": "string" },
              "cocheId": { "type": "string" }
            },
            "required": ["pilotoId", "cocheId"]
          }
        }
      },
      "required": [
        "id",
        "nombre",
        "juegoId",
        "tipo",
        "estado",
        "fechaInicio",
        "pistas",
        "participantes"
      ]
    },
    "Result": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Result",
      "type": "object",
      "description": "Represents a race result in the ChronoSim application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the result. (Primary Key)"
        },
        "eventoId": {
          "type": "string",
          "description": "Reference to the Event entity."
        },
        "teamName": {
          "type": "string"
        },
        "pilotName": {
          "type": "string"
        },
        "carName": {
          "type": "string"
        },
        "tiempoMilisegundos": {
          "type": "number",
          "description": "Final time of the race/stage in milliseconds."
        },
        "posicion": {
          "type": "number",
          "description": "Position in the race (if applicable)."
        },
        "fecha": {
          "type": "string",
          "description": "Timestamp when the time was recorded.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "eventoId",
        "teamName",
        "pilotName",
        "carName",
        "tiempoMilisegundos",
        "posicion",
        "fecha"
      ]
    }
  },
  "auth": {
    "providers": [
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "schema": {
            "$ref": "#/entities/User"
          },
          "description": "Stores user profiles."
        }
      },
      {
        "path": "/games/{gameId}",
        "definition": {
          "schema": {
            "$ref": "#/entities/Game"
          },
          "description": "Stores game information."
        }
      },
      {
        "path": "/tracks/{trackId}",
        "definition": {
          "schema": {
            "$ref": "#/entities/Track"
          },
          "description": "Stores track information."
        }
      },
      {
        "path": "/cars/{carId}",
        "definition": {
          "schema": {
            "$ref": "#/entities/Car"
          },
          "description": "Stores car information."
        }
      },
      {
        "path": "/pilots/{pilotId}",
        "definition": {
          "schema": {
            "$ref": "#/entities/Pilot"
          },
          "description": "Stores pilot information."
        }
      },
      {
        "path": "/teams/{teamId}",
        "definition": {
          "schema": {
            "$ref": "#/entities/Team"
          },
          "description": "Stores team information."
        }
      },
      {
        "path": "/events/{eventId}",
        "definition": {
          "schema": {
            "$ref": "#/entities/Event"
          },
          "description": "Stores event information."
        }
      },
      {
        "path": "/events/{eventId}/results/{resultId}",
        "definition": {
          "schema": {
            "$ref": "#/entities/Result"
          },
          "description": "Stores race results for a specific event."
        }
      }
    ]
  }
}
